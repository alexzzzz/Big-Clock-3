<?xml version="1.0" encoding="utf-8"?>
<!--
  Variant A — CenterSingle (RECOMMENDED default)
  Throwaway prototype — copy to Resources/layout/activity_big_clock.xml when validated.
  Один TextView HH:MM, ':' мигает через Spannable alpha.
  Масштаб: app:autoSizeTextType="uniform" + autoSizePresetSizes, либо кодовый measure.
  Фон #000000, текст #FFFFFF, monospace tabular-nums.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <TextView
        android:id="@+id/clockText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="00:00"
        android:textColor="#FFFFFF"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:gravity="center"
        android:textSize="200sp"
        android:letterSpacing="0.02"
        android:fontFeatureSettings="tnum"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="40sp"
        app:autoSizeMaxTextSize="320sp"
        app:autoSizeStepGranularity="2sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.92"
        app:layout_constraintHeight_percent="0.85"
        app:layout_constraintDimensionRatio="H,3:1" />

</androidx.constraintlayout.widget.ConstraintLayout>
